{% comment %}
  Section contract.
  Dark store footer: brand column (inverse logo, tagline, contact, social), up to three menus,
  newsletter signup, then a bottom bar with copyright, policy links and payment icons.
  @example
  <!-- Lives in the footer group. Pick menus for Shop, Help and Company. -->
{% endcomment %}
{%- liquid
  assign footer_logo = settings.logo_inverse | default: settings.logo
  assign menu_count = 0
  for i in (1..3)
    assign menu_key = 'menu_' | append: i
    if section.settings[menu_key] != blank and section.settings[menu_key].links.size > 0
      assign menu_count = menu_count | plus: 1
    endif
  endfor
-%}
<div class="nv-footer" style="--nv-footer-menu-cols: {% for i in (1..menu_count) %}minmax(0, 0.8fr) {% endfor %};">
  <div class="nv-footer__glow" aria-hidden="true"></div>
  <div class="nv-container">
    <div class="nv-footer__top">
      <div class="nv-footer__brand">
        <a class="nv-footer__logo" href="{{ routes.root_url }}">
          {%- if footer_logo -%}
            {{ footer_logo | image_url: width: 480 | image_tag: widths: '240, 360, 480', sizes: '220px', loading: 'lazy', alt: shop.name }}
          {%- else -%}
            <span>{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
        {%- if section.settings.tagline != blank -%}
          <p class="nv-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        <ul class="nv-footer__contact" role="list">
          {%- if section.settings.email != blank -%}
            <li>
              {% render 'nv-icon', name: 'mail', size: 18 %}
              <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
            </li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li>
              {% render 'nv-icon', name: 'headset', size: 18 %}
              <span>{{ section.settings.hours | escape }}</span>
            </li>
          {%- endif -%}
        </ul>
        {%- liquid
          assign socials = 'facebook,instagram,tiktok,youtube' | split: ','
          assign has_social = false
          for s in socials
            assign key = s | append: '_url'
            if section.settings[key] != blank
              assign has_social = true
            endif
          endfor
        -%}
        {%- if has_social -%}
          <ul class="nv-footer__social" role="list">
            {%- for s in socials -%}
              {%- assign key = s | append: '_url' -%}
              {%- if section.settings[key] != blank -%}
                <li>
                  <a href="{{ section.settings[key] }}" target="_blank" rel="noopener" aria-label="{{ s | capitalize }}">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      {%- case s -%}
                        {%- when 'facebook' -%}
                          <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21z"/>
                        {%- when 'instagram' -%}
                          <path d="M12 7.3A4.7 4.7 0 1 0 12 16.7 4.7 4.7 0 0 0 12 7.3zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM21 8.1c-.1-1.5-.4-2.8-1.5-3.9S17 2.8 15.5 2.7c-1.5-.1-6-.1-7.5 0-1.5.1-2.8.4-3.9 1.5S2.8 6.6 2.7 8.1c-.1 1.5-.1 6 0 7.5.1 1.5.4 2.8 1.5 3.9s2.4 1.4 3.9 1.5c1.5.1 6 .1 7.5 0 1.5-.1 2.8-.4 3.9-1.5s1.4-2.4 1.5-3.9c.1-1.5.1-6 0-7.5zM19 17.6a3 3 0 0 1-1.7 1.7c-1.2.5-4 .4-5.3.4s-4.1.1-5.3-.4A3 3 0 0 1 5 17.6c-.5-1.2-.4-4-.4-5.3s-.1-4.1.4-5.3A3 3 0 0 1 6.7 5.3c1.2-.5 4-.4 5.3-.4s4.1-.1 5.3.4A3 3 0 0 1 19 7c.5 1.2.4 4 .4 5.3s.1 4.1-.4 5.3z"/>
                        {%- when 'tiktok' -%}
                          <path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.7 5.7 0 1 0 4.9 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z"/>
                        {%- when 'youtube' -%}
                          <path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3z"/>
                      {%- endcase -%}
                    </svg>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for i in (1..3) -%}
        {%- liquid
          assign menu_key = 'menu_' | append: i
          assign title_key = 'menu_title_' | append: i
          assign menu = section.settings[menu_key]
        -%}
        {%- if menu != blank and menu.links.size > 0 -%}
          <nav class="nv-footer__col" aria-labelledby="NvFooterMenu-{{ section.id }}-{{ i }}">
            <h2 id="NvFooterMenu-{{ section.id }}-{{ i }}" class="nv-footer__heading">
              {{ section.settings[title_key] | default: menu.title | escape }}
            </h2>
            <ul role="list">
              {%- for link in menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}

      <div class="nv-footer__news">
        <h2 class="nv-footer__heading">{{ section.settings.news_heading | escape }}</h2>
        {%- if section.settings.news_text != blank -%}
          <p class="nv-footer__news-text">{{ section.settings.news_text | escape }}</p>
        {%- endif -%}
        {%- form 'customer', id: 'NvFooterNewsletter', class: 'nv-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="nv-footer__success" role="status">{% render 'nv-icon', name: 'check', size: 18 %} Thanks for subscribing!</p>
          {%- else -%}
            <div class="nv-footer__field">
              <label class="visually-hidden" for="NvFooterEmail-{{ section.id }}">Email address</label>
              <input
                id="NvFooterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                placeholder="Your email address"
                required
                {% if form.errors %}aria-invalid="true" aria-describedby="NvFooterError-{{ section.id }}"{% endif %}
              >
              <button type="submit" class="nv-footer__submit" aria-label="Subscribe">
                {% render 'nv-icon', name: 'arrow', size: 20 %}
              </button>
            </div>
            {%- if form.errors -%}
              <p id="NvFooterError-{{ section.id }}" class="nv-footer__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
        <p class="nv-footer__fine">{{ section.settings.news_fine | escape }}</p>
      </div>
    </div>

    <div class="nv-footer__bottom">
      <p class="nv-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p>
      {%- if shop.policies.size > 0 -%}
        <ul class="nv-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="nv-footer__pay" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'nv-footer__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .nv-footer {
    position: relative;
    overflow: clip;
    isolation: isolate;
    padding-block: clamp(56px, 8vw, 96px) 28px;
    color: rgb(255 255 255 / 0.72);
    background: var(--nv-ink);
  }

  .nv-footer__glow {
    position: absolute;
    inset: -30% auto auto -10%;
    width: 60%;
    height: 80%;
    z-index: -1;
    background: radial-gradient(50% 50% at 50% 50%, rgb(var(--nv-blue-rgb) / 0.22) 0%, transparent 70%);
  }

  .nv-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s var(--nv-ease);
  }

  .nv-footer a:hover {
    color: var(--nv-white);
  }

  .nv-footer a:focus-visible,
  .nv-footer button:focus-visible,
  .nv-footer input:focus-visible {
    outline: 2px solid var(--nv-blue-bright);
    outline-offset: 2px;
  }

  .nv-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) var(--nv-footer-menu-cols, ) minmax(0, 1.4fr);
    gap: 40px 32px;
    padding-bottom: clamp(40px, 6vw, 64px);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .nv-footer__logo img {
    width: 200px;
    height: auto;
  }

  .nv-footer__logo span {
    font-family: var(--font-heading--family);
    font-size: 1.6rem;
    color: var(--nv-white);
  }

  .nv-footer__tagline {
    margin: 18px 0 0;
    line-height: 1.6;
    max-width: 34ch;
  }

  .nv-footer__contact,
  .nv-footer__col ul,
  .nv-footer__social,
  .nv-footer__policies,
  .nv-footer__pay {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nv-footer__contact {
    display: grid;
    gap: 10px;
    margin-top: 22px;
    font-size: 0.92rem;
  }

  .nv-footer__contact li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .nv-footer__contact .nv-icon {
    color: var(--nv-blue-bright);
  }

  .nv-footer__social {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }

  .nv-footer__social a {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.1);
    transition: background-color 0.3s var(--nv-ease), transform 0.3s var(--nv-ease);
  }

  .nv-footer__social a:hover {
    background: var(--nv-blue);
    transform: translateY(-2px);
  }

  .nv-footer__heading {
    margin: 0 0 18px;
    font-family: var(--font-subheading--family);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--nv-white);
  }

  .nv-footer__col ul {
    display: grid;
    gap: 12px;
    font-size: 0.95rem;
  }

  .nv-footer__news-text {
    margin: 0 0 18px;
    line-height: 1.6;
  }

  .nv-footer__field {
    display: flex;
    align-items: center;
    padding: 6px 6px 6px 18px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.06);
    border: 1px solid rgb(255 255 255 / 0.14);
    transition: border-color 0.3s var(--nv-ease);
  }

  .nv-footer__field:focus-within {
    border-color: var(--nv-blue-bright);
  }

  .nv-footer__field input {
    flex: 1;
    min-width: 0;
    padding: 10px 0;
    border: 0;
    background: transparent;
    color: var(--nv-white);
    font-size: 0.95rem;
    outline: none;
  }

  .nv-footer__field input::placeholder {
    color: rgb(255 255 255 / 0.45);
  }

  .nv-footer__submit {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 10px;
    color: var(--nv-white);
    background: var(--nv-accent-grad);
    cursor: pointer;
    transition: transform 0.3s var(--nv-ease), box-shadow 0.3s var(--nv-ease);
  }

  .nv-footer__submit:hover {
    transform: translateX(2px);
    box-shadow: var(--nv-glow);
  }

  .nv-footer__success {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: var(--nv-white);
  }

  .nv-footer__error {
    margin: 10px 0 0;
    color: #ff8a8a;
    font-size: 0.85rem;
  }

  .nv-footer__fine {
    margin: 12px 0 0;
    font-size: 0.78rem;
    color: rgb(255 255 255 / 0.45);
  }

  .nv-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 28px;
    padding-top: 24px;
    font-size: 0.82rem;
  }

  .nv-footer__copy {
    margin: 0;
  }

  .nv-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .nv-footer__pay {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .nv-footer__pay-icon {
    width: 38px;
    height: 24px;
  }

  @media (max-width: 1099px) {
    .nv-footer__top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .nv-footer__brand,
    .nv-footer__news {
      grid-column: span 3;
    }
  }

  @media (max-width: 599px) {
    .nv-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nv-footer__brand,
    .nv-footer__news {
      grid-column: span 2;
    }

    .nv-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nuvravo footer",
  "tag": "div",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Smart car accessories, selected for drivers who care. Drive a smarter you." },
    { "type": "text", "id": "email", "label": "Support email", "default": "support@nuvravo.com" },
    { "type": "text", "id": "hours", "label": "Support hours" },
    { "type": "link_list", "id": "menu_1", "label": "Menu 1" },
    { "type": "text", "id": "menu_title_1", "label": "Menu 1 title", "default": "Shop" },
    { "type": "link_list", "id": "menu_2", "label": "Menu 2" },
    { "type": "text", "id": "menu_title_2", "label": "Menu 2 title", "default": "Help" },
    { "type": "link_list", "id": "menu_3", "label": "Menu 3" },
    { "type": "text", "id": "menu_title_3", "label": "Menu 3 title", "default": "Company" },
    { "type": "text", "id": "news_heading", "label": "Newsletter heading", "default": "Join the Nuvravo garage" },
    { "type": "text", "id": "news_text", "label": "Newsletter text", "default": "New arrivals, care tips and member-only offers. No spam." },
    { "type": "text", "id": "news_fine", "label": "Newsletter fine print", "default": "You can unsubscribe at any time." },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" }
  ],
  "presets": [{ "name": "Nuvravo footer" }]
}
{% endschema %}
