{% comment %}
  Section contract.
  "Shop by category" bento grid. Each block picks a collection; the tile shows its image
  (or an override), title, product count and a short tagline, with a hover zoom.
  @example
  <!-- Add one "Category" block per collection; the first tile spans two rows on desktop. -->
{% endcomment %}
<section class="nv-section nv-cats" aria-labelledby="NvCatsTitle-{{ section.id }}">
  <div class="nv-container">
    <div class="nv-head">
      <div data-nv-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="NvCatsTitle-{{ section.id }}" class="nv-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="nv-lede">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <a class="nv-link" href="{{ routes.all_products_collection_url }}" data-nv-reveal>
        {{- section.settings.link_label | escape -}}
        {% render 'nv-icon', name: 'arrow', size: 18 %}
      </a>
    </div>

    <ul class="nv-cats__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- assign tile_image = block.settings.image | default: collection.featured_image -%}
        <li class="nv-cats__item" data-nv-reveal style="--nv-delay: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <a class="nv-cats__tile" href="{{ collection.url | default: routes.collections_url }}">
            <span class="nv-cats__media">
              {%- if tile_image -%}
                {{
                  tile_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'nv-cats__placeholder' }}
              {%- endif -%}
            </span>
            <span class="nv-cats__shade" aria-hidden="true"></span>
            <span class="nv-cats__body">
              {%- if collection != blank -%}
                <span class="nv-cats__count">
                  {{- collection.products_count }}
                  {% if collection.products_count == 1 %}product{% else %}products{% endif -%}
                </span>
              {%- endif -%}
              <span class="nv-cats__name">{{ block.settings.title | default: collection.title | escape }}</span>
              {%- if block.settings.tagline != blank -%}
                <span class="nv-cats__tagline">{{ block.settings.tagline | escape }}</span>
              {%- endif -%}
              <span class="nv-cats__cta">
                Shop now
                {% render 'nv-icon', name: 'arrow', size: 16 %}
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .nv-cats__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: clamp(220px, 22vw, 300px);
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nv-cats__item:first-child {
    grid-row: span 2;
  }

  .nv-cats__tile {
    position: relative;
    display: block;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    color: var(--nv-white);
    text-decoration: none;
    background: var(--nv-graphite);
    isolation: isolate;
  }

  .nv-cats__media,
  .nv-cats__shade {
    position: absolute;
    inset: 0;
  }

  .nv-cats__media img,
  .nv-cats__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--nv-ease);
  }

  .nv-cats__tile:hover .nv-cats__media img {
    transform: scale(1.07);
  }

  .nv-cats__shade {
    background: linear-gradient(180deg, rgb(10 15 28 / 0) 30%, rgb(10 15 28 / 0.88) 100%);
    transition: background 0.6s var(--nv-ease);
  }

  .nv-cats__tile:hover .nv-cats__shade {
    background: linear-gradient(180deg, rgb(var(--nv-blue-rgb) / 0.1) 0%, rgb(10 15 28 / 0.92) 100%);
  }

  .nv-cats__body {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: clamp(18px, 2.4vw, 28px);
  }

  .nv-cats__count {
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgb(255 255 255 / 0.14);
    backdrop-filter: blur(8px);
  }

  .nv-cats__name {
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.35rem, 1rem + 1vw, 1.9rem);
    line-height: 1.1;
  }

  .nv-cats__tagline {
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.75);
  }

  .nv-cats__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--nv-blue-bright);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s var(--nv-ease), transform 0.5s var(--nv-ease);
  }

  .nv-cats__tile:hover .nv-cats__cta,
  .nv-cats__tile:focus-visible .nv-cats__cta {
    opacity: 1;
    transform: none;
  }

  .nv-cats__tile:focus-visible {
    outline: 3px solid var(--nv-blue);
    outline-offset: 3px;
  }

  @media (hover: none) {
    .nv-cats__cta {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 989px) {
    .nv-cats__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .nv-cats__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 220px;
    }

    .nv-cats__item:first-child {
      grid-row: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Nuvravo categories",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything your car needs" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All categories" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "presets": [{ "name": "Nuvravo categories" }]
}
{% endschema %}
