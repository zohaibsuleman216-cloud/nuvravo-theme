{% comment %}
  Section contract.
  Homepage product row: heading with "view all" link and Nuvravo product cards from a collection,
  shown as a grid or a swipeable row.
  @example
  <!-- Pick a collection (or leave blank for all products) and a layout. -->
{% endcomment %}
{%- liquid
  assign source = section.settings.collection | default: collections.all
  assign view_all = source.url | default: routes.all_products_collection_url
-%}
<section class="nv-section nv-pgrid{% if section.settings.surface %} nv-section--surface{% endif %}" aria-labelledby="NvGridTitle-{{ section.id }}">
  <div class="nv-container">
    <div class="nv-head" data-nv-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="nv-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="NvGridTitle-{{ section.id }}" class="nv-title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="nv-lede">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <a class="nv-btn nv-btn--outline" href="{{ view_all }}">
        {{- section.settings.link_label | escape -}}
        {% render 'nv-icon', name: 'arrow', size: 18 %}
      </a>
    </div>

    <ul class="nv-grid{% if section.settings.layout == 'scroll' %} nv-grid--scroll{% endif %}" role="list">
      {%- for product in source.products limit: section.settings.limit -%}
        <li data-nv-reveal style="--nv-delay: {{ forloop.index0 | modulo: 4 }}">
          {% render 'nv-product-card', product: product, loading: 'lazy' %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Nuvravo product grid",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection (blank shows all products)" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "grid",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "scroll", "label": "Swipeable row" }
      ]
    },
    { "type": "checkbox", "id": "surface", "label": "Tinted background", "default": false },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" }
  ],
  "presets": [{ "name": "Nuvravo product grid" }]
}
{% endschema %}
